---
import { getStrings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getStrings(lang);
// Drop real photos into public/images/ and replace the placeholders below
// (use the alt text in src/i18n/*.json -> gallery.alts).
---

<section id="gallery">
  <div class="container">
    <h2 class="section-title">{t.gallery.title}</h2>
    <hr class="section-divider" />
    <p class="section-subtitle">{t.gallery.subtitle}</p>

    <div class="gallery-grid">
      {t.gallery.alts.map(() => (
        <div class="gallery-item">
          <div class="gallery-placeholder">📸</div>
        </div>
      ))}
    </div>
  </div>
</section>
