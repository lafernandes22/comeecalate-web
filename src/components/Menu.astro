---
import menuData from '../data/menu.json';
import { getStrings, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getStrings(lang);
const text = t.menuItems as Record<
  string,
  { name: string; items: Record<string, { name: string; description: string }> }
>;
---

<section id="menu">
  <div class="container">
    <h2 class="section-title">{t.menu.title}</h2>
    <hr class="section-divider" />
    <p class="section-subtitle">{t.menu.subtitle}</p>

    <div class="menu-categories">
      {menuData.categories.map((category) => (
        <div class="menu-category">
          <h3>{text[category.id].name}</h3>
          <div class="menu-items">
            {category.items.map((item) => (
              <div class="menu-item">
                <div class="menu-item-header">
                  <span class="menu-item-name">{text[category.id].items[item.id].name}</span>
                  <span class="menu-item-price">{item.price}</span>
                </div>
                <p class="menu-item-desc">{text[category.id].items[item.id].description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
